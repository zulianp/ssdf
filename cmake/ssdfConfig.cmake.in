@PACKAGE_INIT@

# Resolve transitive dependencies needed by exported targets.
# This matters because `ssdfTargets.cmake` may reference imported targets like
# `OpenMP::OpenMP_CXX` or `MPI::MPI_CXX`.
include(CMakeFindDependencyMacro)

if(@SSDF_ENABLE_MPI@)
  find_dependency(MPI COMPONENTS CXX)
endif()

if(@SSDF_ENABLE_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()

# Include the exported targets
include("${CMAKE_CURRENT_LIST_DIR}/ssdfTargets.cmake")

# Check for optional dependencies if needed
check_required_components(ssdf)

